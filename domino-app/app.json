{
  "expo": {
    "name": "Domino",
    "slug": "domino-app",
    "scheme": "domino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.domino.tracker"
    },
    "android": {
      "package": "app.domino.tracker",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#F4633A"
        }
      ],
      "expo-sharing"
    ]
  }
}
